{
  "name": "typescript-werkstatt",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TypeScript-Werkstatt: Support-Tickets der HiTec GmbH",
  "scripts": {
    "test": "vitest run",
    "test:ab01": "vitest run src/ticket.test.ts",
    "test:ab02": "vitest run src/ticket-list.test.ts",
    "test:ab03": "vitest run src/ticket-store.test.ts",
    "test:watch": "vitest",
    "check": "tsc --noEmit",
    "verify": "node scripts/verify.mjs",
    "errors": "tsc --noEmit -p tsconfig.errors.json",
    "errors:run": "tsx explore/type-errors.ts",
    "display": "tsx explore/display.ts",
    "load": "tsx explore/load.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
